    "@iso20022-bank-kit/connector-bac": "0.1.0",
    "@iso20022-bank-kit/conformance": "0.1.0",
    "@iso20022-bank-kit/graphql": "0.1.0",
    "@iso20022-bank-kit/mcp": "0.1.0",
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.4.0"
  },
  "publishConfig": {
